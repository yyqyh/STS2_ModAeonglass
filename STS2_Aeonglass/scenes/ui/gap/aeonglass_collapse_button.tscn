[sub_resource type="Shader" id="Shader_crack"]
code = "shader_type canvas_item;\n\n// 裂缝着色：tint = 要闪的颜色（玫红 / 白），amount = 0 时保持原样的近黑裂缝。\n// 素材本身是近黑（均色约 34,30,22），没法用 modulate 提亮（multiply 只会更黑），所以用 mix 换色。\nuniform vec4 tint : source_color = vec4(1.0, 1.0, 1.0, 1.0);\nuniform float amount : hint_range(0.0, 1.0) = 0.0;\n\nvoid fragment() {\n\tvec4 tex = texture(TEXTURE, UV);\n\tCOLOR.rgb = mix(tex.rgb, tint.rgb, amount);\n\tCOLOR.a = tex.a;\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_crack"]
shader = SubResource("Shader_crack")
shader_parameter/tint = Color(1, 1, 1, 1)
shader_parameter/amount = 0.0

