[sub_resource type="Shader" id="Shader_wave"]
code = "shader_type canvas_item;

// 环中间的\"波浪\"：贴图竖向循环滚动 + 正弦横向推 —— 本体沙漏 LiquidSlot 那套流动感。
uniform float speed : hint_range(-3.0, 3.0) = 0.35;
uniform float wave_strength : hint_range(0.0, 0.3) = 0.05;
uniform float wave_frequency : hint_range(1.0, 40.0) = 9.0;
uniform float twist_speed : hint_range(0.0, 6.0) = 1.4;

void fragment() {
	vec2 uv = UV;
	uv.y = fract(uv.y - TIME * speed);
	uv.x = clamp(uv.x + sin(uv.y * wave_frequency + TIME * twist_speed) * wave_strength, 0.0, 1.0);
	vec4 tex = texture(TEXTURE, uv);
	COLOR = vec4(tex.rgb * COLOR.rgb, tex.a * COLOR.a);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_wave"]
shader = SubResource("Shader_wave")
shader_parameter/speed = 0.35
